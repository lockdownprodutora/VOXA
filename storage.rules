rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    
    // Allow read access to all files
    match /{allPaths=**} {
      allow read: if true;
    }

    // Secure user-specific directory path
    match /users/{userId}/{allPaths=**} {
      allow write: if request.auth != null && request.auth.uid == userId;
    }
  }
}
