      "**/.*",
      "**/node_modules/**"
    ],
    "rewrites": [
      {
        "source": "**",
        "destination": "/index.html"
      }
    ]
  },
  "firestore": [
    {
      "database": "ai-studio-voxa-88b709d6-62fd-4a0d-b036-525f4b713a4e",
      "rules": "firestore.rules"
    }
  ],
  "storage": {
